# Fill these from Supabase Cloud + Stripe, then run:
#   pwsh scripts/push-vercel-prod-env.ps1
#
# Create Supabase: https://supabase.com/dashboard → New project
# Keys: Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://ionexflow.vercel.app

# Stripe (Dashboard → Developers → API keys + Webhooks)
# Webhook URL: https://ionexflow.vercel.app/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google OAuth (also enable Google in Supabase Auth → Providers)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

OPENAI_API_KEY=
# or ANTHROPIC_API_KEY=

# Cron (call GET /api/cron/tick every 5m via external cron on Hobby)
CRON_SECRET=

# AES-256 for mailbox passwords (64 hex chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_CREDENTIALS_ENCRYPTION_KEY=

