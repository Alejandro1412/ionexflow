NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: https://your-domain.com

# Set true only after GOOGLE_OAUTH_* are configured for local Supabase
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Stripe (required in production — see docs/DEPLOY.md)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NEVER set this on Vercel Production
# ALLOW_DEV_BILLING_BYPASS=true

# Agent intelligence
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
IONEX_AI_PROVIDER=

# Notifications + outbound email (optional)
RESEND_API_KEY=
RESEND_FROM=IonexFlow <onboarding@resend.dev>
EMAIL_INBOUND_SECRET=
# AES-256 for mailbox passwords (64 hex). Optional locally if SUPABASE_SERVICE_ROLE_KEY is set.
EMAIL_CREDENTIALS_ENCRYPTION_KEY=
CRON_SECRET=

# WhatsApp Cloud API (optional — verify token also set per connection in Integrations)
WHATSAPP_VERIFY_TOKEN=

# Voice inbound webhook token fallback (prefer per-org token in Integrations)
VOICE_WEBHOOK_SECRET=

# Optional headless browser worker for browser_agent nodes
BROWSER_WORKER_URL=
BROWSER_WORKER_SECRET=
